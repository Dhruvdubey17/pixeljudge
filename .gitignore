# ---- DVC-managed data (tracked by DVC, not git) ----
# Ignore the *contents* rather than the directory itself: git never looks inside
# an ignored directory, so a "!" re-include for .gitkeep would be dead weight.
/data/raw/*
/data/encoded/*
/data/metrics/*
/data/datasets/*
!/data/raw/.gitkeep
!/data/encoded/.gitkeep
!/data/metrics/.gitkeep
!/data/datasets/.gitkeep
/notebooks/*
!/notebooks/.gitkeep

# ---- Trained model artifacts (regenerated by `pixeljudge train` / `mos train`) ----
/models/*.joblib
/models/*.pkl
/models/*.json
/models/*.csv

# ---- Generated reports (plots/tables regenerated by the pipeline) ----
# Everything here is reproducible with `pixeljudge report`, so it is ignored by
# default. The exceptions are the handful of figures and tables the README embeds:
# a README whose images 404 on GitHub is not a results-first README.
/reports/*.png
/reports/*.csv
/reports/*.md
/reports/*.html
/reports/evidence/
!/reports/banding_master_vs_encode.png
!/reports/metric_vs_banding.png
!/reports/rd_curves_codecs_big_buck_bunny.png
!/reports/rd_curves_ladders_sintel.png
!/reports/bd_rate.csv
!/reports/bd_rate.md
!/reports/blind_spots.csv
!/reports/blind_spots.md
!/reports/ladder_summary.csv
!/reports/ladder_summary.md
!/reports/mos_correlation.png
!/reports/mos_correlation.csv
!/reports/mos_correlation.md
!/reports/mos_correlation_folds.csv
!/reports/mos_correlation_folds.md

